# Salin ke .env.local lalu isi. Di Vercel: Project → Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend (form Hubungi Kami) → https://resend.com/api-keys
RESEND_API_KEY=
# Email tujuan pesan dari form Hubungi Kami
CONTACT_TO_EMAIL=
# Pengirim. Tanpa domain sendiri, pakai onboarding@resend.dev
CONTACT_FROM_EMAIL=TSA IPB Website <onboarding@resend.dev>

# URL publik website (untuk sitemap & Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
